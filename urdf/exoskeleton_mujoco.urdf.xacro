<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="exoskeleton">

    <xacro:include filename="$(find exoskeleton_description)/urdf/properties.xacro"/>
    <xacro:include filename="$(find exoskeleton_description)/urdf/inertias.xacro"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.9" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.08 1.8"/>
            </geometry>
        </visual>
    </link>

    <joint name="base_joint" type="fixed">
        <origin xyz="-0.03 0.04075 1.39" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="fixed_bar_link"/>
    </joint>

    <link name="fixed_bar_link">
        <visual>
            <origin xyz="0.0 0.027 0.04" rpy="${pi/2} 0 -${pi/2}"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual/stl_models/fixed_thin.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.06 0.044 0.01" rpy="0 0 0"/>
            <geometry>
                <box size="${short_bar} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
    </link>

    <!-- ACTIVE JOINT -->
    <joint name="hip_motor_joint_base" type="revolute">
        <parent link="fixed_bar_link"/>
        <child link="short_bar_wide_link"/>
        <origin xyz="0 0.044 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5" upper="0.5" effort="${max_effort}" velocity="${max_velocity}"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>
   <!--${-loop_radius} 0 0.04 -->
    <link name="short_bar_wide_link">
        <visual>
            <origin xyz="0 0 0.04" rpy="${pi/2} 0 ${-pi/2}"/>
           <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual/stl_models/wide_long.stl" scale="0.001 0.001 0.001"/>
           </geometry> 
        </visual>
        <collision>
            <origin xyz="0 ${0.5*short_bar-0.005} ${-0.5*bar_height-0.001}" rpy="0 0 0"/>
            <geometry>
                <box size="${bar_width} ${long_bar} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:long_bar_wide_inertia />
    </link>

    <!-- PASSIVE JOINT -->
    <joint name="sbw_cbt_joint" type="continuous">
        <parent link="short_bar_wide_link"/>
        <child link="connecting_bar_thin_link"/>
        <origin xyz="0 ${short_bar-0.01} 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="connecting_bar_thin_link">
        <visual>
            <origin xyz="${short_bar-0.04} 0 ${-bar_height-0.1665-0.0025}" rpy="0 0 ${-pi/2}"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual/stl_models/connecting_thin.stl" scale="0.001 0.001 0.001"/> 
            </geometry>
        </visual>
        <collision>
            <origin xyz="${0.5*(short_bar+long_bar)-0.04} 0 ${0.5*bar_height}" rpy="0 0 0"/>
            <geometry>
                <box size="${short_bar+long_bar-0.04} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:connecting_bar_thin_inertia />
    </link>

    <!-- PASSIVE JOINT -->
    <joint name="fbs_cbw_joint" type="continuous">
        <parent link="fixed_bar_link"/>
        <child link="connecting_bar_wide_link"/>
        <origin xyz="${short_bar-0.04} 0.044 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="connecting_bar_wide_link">
        <visual>
            <origin xyz="0 ${long_bar-0.04} ${-bar_height-0.1665-0.0025}" rpy="0 0 ${-pi/2}"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual/stl_models/connecting_wide.stl" scale="0.001 0.001 0.001"/> 
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 ${0.5*(short_bar+long_bar)-0.04} ${-0.5*bar_height-0.001}" rpy="0 0 ${pi/2}"/>
            <geometry>
                <box size="${short_bar+long_bar-0.04} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:connecting_bar_wide_inertia />
    </link>

    <!-- PASSIVE JOINT -->
    <joint name="cbw_lbt_joint" type="continuous">
        <parent link="connecting_bar_wide_link"/>
        <child link="long_bar_thin_link"/>
        <origin xyz="0 ${(long_bar+short_bar)-0.08} 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="long_bar_thin_link">
        <visual>
            <origin xyz="0 0 ${-bar_height-0.1665-0.0025}" rpy="0 0 ${pi/2}"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual/stl_models/wide_long.stl" scale="0.001 0.001 0.001"/>
            </geometry> 
        </visual>
        <collision>
            <origin xyz="${0.5*short_bar-0.005} 0 ${0.5*bar_height}" rpy="0 0 ${pi/2}"/>
            <geometry>
                <box size="${bar_width} ${long_bar} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:long_bar_thin_inertia />
    </link>

    <!-- PASSIVE JOINT -->
    <joint name="cbt_support_joint" type="continuous">
        <parent link="connecting_bar_thin_link"/>
        <child link="support_bar_link"/>
        <origin xyz="${(long_bar+short_bar)-0.08} 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="support_bar_link">
        <visual>
            <origin xyz="0 0.06 ${0.038/2+bar_height}" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual/stl_models/short_thin.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 ${0.5*short_bar-0.02} ${1.5*bar_height+0.001}" rpy="0 0 ${pi/2}"/>
            <geometry>
                <box size="${short_bar} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:short_bar_leg_inertia />
    </link>

    <!-- PASSIVE JOINT -->
    <joint name="support_hip_joint" type="continuous">
        <parent link="support_bar_link"/>
        <child link="hip_link"/>
        <origin xyz="0 0 ${-bottom_low_hip_dist}" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="hip_link">
        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 ${-pi/2}"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual/stl_models/thigh.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 -${low_hip_knee_dist/2} ${bar_height/2}"/>
            <geometry>
                <box size="${bar_width} ${low_hip_knee_dist} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:thigh_inertia />
    </link>

    <joint name="knee_joint" type="revolute">
        <parent link="hip_link"/>
        <child link="leg_link"/>
        <origin xyz="0 ${-low_hip_knee_dist} 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5" upper="0.5" effort="${max_effort}" velocity="${max_velocity}"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>
   
    <link name="leg_link">
        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 ${-pi/2}"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual/stl_models/leg.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 -${knee_ankle_dist/2} ${-bar_height/2-0.001}"/>
            <geometry>
                <box size="${bar_width} ${knee_ankle_dist} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:leg_inertia />
    </link>

    <joint name="ankle_joint" type="revolute">
        <parent link="leg_link"/>
        <child link="foot_link"/>
        <origin xyz="0 ${-knee_ankle_dist} 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5" upper="0.5" effort="${max_effort}" velocity="${max_velocity}"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>
   
    <link name="foot_link">
        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} ${pi} ${pi}"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual/stl_models/foot.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 -${ankle_floor_dist/2} ${bar_height/2}"/>
            <geometry>
                <box size="${bar_width} ${ankle_floor_dist} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:foot_inertia />
    </link>

    <!-- ================================================================= -->
    <!-- MUJOCO NATIVE LOOP CLOSURES & PHYSICS PARAMETERS                  -->
    <!-- ================================================================= -->
    <mujoco>
        <compiler balanceinertia="true" discardvisual="false"/>
        
        <equality>
            <!-- Loop 1 Closure: First Parallelogram (Using your xacro properties for offsets) -->
            <connect body1="connecting_bar_wide_link" body2="connecting_bar_thin_link" anchor="${short_bar} 0 0"/>
            
            <!-- Loop 2 Closure: Second Parallelogram -->
            <connect body1="long_bar_thin_link" body2="support_bar_link" anchor="0 ${long_bar} 0"/>
        </equality>
    </mujoco>

    <!-- ================================================================= -->
    <!-- ROS 2 CONTROL (Updated for MuJoCo)                                -->
    <!-- ================================================================= -->
    <ros2_control name="MujocoSystem" type="system">
        <hardware>
            <!-- Switched from GazeboSystem to MujocoSystem -->
            <plugin>mujoco_ros2_control/MujocoSystem</plugin>
        </hardware>
        
        <!-- Only command the driven joints -->
        <joint name="hip_motor_joint_base">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="knee_joint">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="ankle_joint">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Passive joints only need state interfaces to broadcast their position to RViz -->
        <joint name="sbw_cbt_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="fbs_cbw_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="cbw_lbt_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="cbt_support_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="support_hip_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>
    
</robot>