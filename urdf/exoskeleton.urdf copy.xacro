                <xyz>0 0 1</xyz>
            </axis>
        </joint>
   </gazebo>

   <gazebo>


   <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystemm</plugin>
        </hardware>
        <joint name="hip_motor_joint_base">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <stateinterface name="velocity"/>
        </joint>
   </ros2_control> -->
</robot>