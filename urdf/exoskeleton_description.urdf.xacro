<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="exoskeleton">

    <xacro:include filename="$(find exoskeleton_description)/urdf/properties.xacro"/>
    <xacro:include filename="$(find exoskeleton_description)/urdf/inertias.xacro"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.9" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.08 1.8"/>
            </geometry>
        </visual>
    </link>

    <!-- Absorbed the 0.044m Y-offset into base_joint so Frame 0 sits directly on the first joint axis 
        Also used the values from here to move the connecting bar according to the world coordinates into the 
        first joint coordinates inside the <mujoco tag>
    -->
    <joint name="base_joint" type="fixed">
        <origin xyz="-0.03 ${0.04075 + 0.044} 1.39" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="fixed_bar_link"/>
    </joint>

    <link name="fixed_bar_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual_bin/hip/support_base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.06 0 0.01" rpy="0 0 0"/>
            <geometry>
                <box size="${short_bar} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
    </link>

    <!-- ACTIVE JOINT (MDH: alpha=0, a=0, d=0, theta=pi/2) -->
    <joint name="hip_motor_joint_base" type="revolute">
        <parent link="fixed_bar_link"/>
        <child link="short_bar_wide_link"/>
        <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5" upper="0.5" effort="${max_effort}" velocity="${max_velocity}"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="short_bar_wide_link">
        <visual>
            <origin xyz="0 0 -0.00125" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual_bin/hip/long_thick.stl" scale="0.001 0.001 0.001"/>
            </geometry> 
        </visual>
        <collision>
            <origin xyz="${0.5*short_bar-0.005} 0 ${-0.5*bar_height-0.00125}" rpy="0 0 0"/>
            <geometry>
                <box size="${long_bar} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:long_bar_wide_inertia />
    </link>

    <!-- PASSIVE JOINT (MDH: alpha=0, a=short_bar-0.01, d=0, theta=-pi/2) -->
    <joint name="sbw_cbt_joint" type="continuous">
        <parent link="short_bar_wide_link"/>
        <child link="connecting_bar_thin_link"/>
        <origin xyz="${short_bar-0.01} 0 0" rpy="0 0 ${-pi/2}"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="connecting_bar_thin_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual_bin/hip/connecting_thin.stl" scale="0.001 0.001 0.001"/> 
            </geometry>
        </visual>
        <collision>
            <origin xyz="${0.5*(short_bar+long_bar)-0.04} 0 ${0.5*bar_height}" rpy="0 0 0"/>
            <geometry>
                <box size="${short_bar+long_bar-0.04} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:connecting_bar_thin_inertia />
    </link>

    <!-- PASSIVE JOINT (MDH: alpha=0, a=short_bar-0.04, d=0, theta=pi/2) -->
    <joint name="fbs_cbw_joint" type="continuous">
        <parent link="fixed_bar_link"/>
        <child link="connecting_bar_wide_link"/>
        <origin xyz="${short_bar-0.04} 0 0" rpy="0 0 ${pi/2}"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="connecting_bar_wide_link">
        <visual>
            <origin xyz="0 0 -0.00125" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual_bin/hip/connecting_thick.stl" scale="0.001 0.001 0.001"/> 
            </geometry>
        </visual>
        <collision>
            <origin xyz="${0.5*(short_bar+long_bar)-0.04} 0 ${-0.5*bar_height-0.00125}" rpy="0 0 0"/>
            <geometry>
                <box size="${short_bar+long_bar-0.04} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:connecting_bar_wide_inertia />
    </link>

    <!-- PASSIVE JOINT (MDH: alpha=0, a=(long_bar+short_bar)-0.08, d=0, theta=-pi/2) -->
    <joint name="cbw_lbt_joint" type="continuous">
        <parent link="connecting_bar_wide_link"/>
        <child link="long_bar_thin_link"/>
        <origin xyz="${(long_bar+short_bar)-0.08} 0 0" rpy="0 0 ${-pi/2}"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="long_bar_thin_link">
        <visual>
            <origin xyz="0 0 -0.0025" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual_bin/hip/thin.stl" scale="0.001 0.001 0.001"/>
            </geometry> 
        </visual>
        <collision>
            <origin xyz="${0.5*short_bar-0.005} 0 ${0.5*bar_height}" rpy="0 0 0"/>
            <geometry>
                <box size="${long_bar} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:long_bar_thin_inertia />
    </link>

    <!-- PASSIVE JOINT (MDH: alpha=0, a=(long_bar+short_bar)-0.08, d=0, theta=pi/2) -->
    <joint name="cbt_support_joint" type="continuous">
        <parent link="connecting_bar_thin_link"/>
        <child link="support_bar_link"/>
        <origin xyz="${(long_bar+short_bar)-0.08} 0 0" rpy="0 0 ${pi/2}"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="support_bar_link">
        <visual>
            <origin xyz="0 0 ${bar_height-0.00125}" rpy="${pi} 0 0"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual_bin/hip/hip_to_thigh.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="${0.5*short_bar-0.02} 0 ${1.5*bar_height+0.00125}" rpy="0 0 0"/>
            <geometry>
                <box size="${short_bar} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:short_bar_leg_inertia />
    </link>

    <!-- ACTIVE JOINT (MDH: Rot_x(pi/2) * Rot_z(-pi/2) -> rpy="0 ${pi/2} ${-pi/2}") -->
    <joint name="support_hip_joint" type="revolute">
        <parent link="support_bar_link"/> <!-- Horizontal hip joint actuated -->
        <child link="hip_link"/>
        <origin xyz="0 0 ${-bottom_low_hip_dist}" rpy="0 ${pi/2} 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="hip_link">
        <visual>
            <origin xyz="0 0 0" rpy="${pi} 0 0"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual_bin/thigh.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="${low_hip_knee_dist/2} 0 ${bar_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${low_hip_knee_dist} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:thigh_inertia />
    </link>

    <!-- ACTIVE JOINT (MDH: alpha=0, a=low_hip_knee_dist, d=0, theta=0) -->
    <joint name="knee_joint" type="revolute">
        <parent link="hip_link"/>
        <child link="leg_link"/>
        <origin xyz="${low_hip_knee_dist} 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5" upper="0.5" effort="${max_effort}" velocity="${max_velocity}"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>
   
    <link name="leg_link">
        <visual>
            <origin xyz="0 0 0" rpy="${pi} 0 0"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual_bin/leg.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="${knee_ankle_dist/2} 0 ${-bar_height/2-0.001}" rpy="0 0 0"/>
            <geometry>
                <box size="${knee_ankle_dist} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:leg_inertia />
    </link>

    <!-- ACTIVE JOINT (MDH: alpha=0, a=knee_ankle_dist, d=0, theta=0) -->
    <joint name="ankle_joint" type="revolute">
        <parent link="leg_link"/>
        <child link="foot_link"/>
        <origin xyz="${knee_ankle_dist} 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5" upper="0.5" effort="${max_effort}" velocity="${max_velocity}"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>
   
    <link name="foot_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 ${pi} 0"/>
            <geometry>
                <mesh filename="package://exoskeleton_description/meshes/visual_bin/foot.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="${ankle_floor_dist/2} 0 ${bar_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${ankle_floor_dist} ${bar_width} ${bar_height}"/>
            </geometry>
        </collision>
        <xacro:foot_inertia />
    </link>

    <!-- ================================================================= -->
    <!-- MUJOCO NATIVE LOOP CLOSURES & PHYSICS PARAMETERS                  -->
    <!-- ================================================================= -->
    <mujoco>
        <compiler balanceinertia="true" discardvisual="false"/>
        
        <equality>
            <!-- Loop 1 Closure
            the MuJoCo compiler uses the body1 coordinate frame to describe the ancors:
                X-axis: Move from connecting_bar_wide_link frame on the x-axis by long_bar
                Y-axis: no movement of the y-axis
                Z-axis: move by 1 bar_height/2 on the z-axis 
             -->
            <connect 
            body1="connecting_bar_wide_link" 
            body2="connecting_bar_thin_link" 
            anchor="${long_bar} 0 ${bar_height / 2}"
            solref="0.004 1" solimp="0.95 0.99 0.001 0.5 2"
            />

            <!-- Loop 2 Closure
            the MuJoCo compiler uses the body1 coordinate frame to describe the ancors:
                X-axis: Move from connecting_bar_wide_link frame on the x-axis by long_bar
                Y-axis: no movement of the y-axis
                Z-axis: move by 1 bar_height/2 on the z-axis            
            -->
            <connect 
            body1="long_bar_thin_link" 
            body2="support_bar_link" 
            anchor="${long_bar} 0 ${bar_height / 2}"
            solref="0.004 1" solimp="0.95 0.99 0.001 0.5 2"
            />

        </equality>
    </mujoco>

    <!-- ================================================================= -->
    <!-- ROS 2 CONTROL  -->
    <!-- ================================================================= -->
    <ros2_control name="MujocoSystem" type="system">
        <hardware>
            <plugin>mujoco_ros2_control/MujocoSystem</plugin>
        </hardware>
        
        <!-- Only command the driven joints -->
        <!--Veritcal hip joint-->>
        <joint name="hip_motor_joint_base">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!--Horizontal hip joint-->>
        <joint name="support_hip_joint">
            <command_interface name="effort"/>
             <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="knee_joint">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="ankle_joint">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Passive joints only need state interfaces to broadcast their position to RViz -->
        <joint name="sbw_cbt_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="fbs_cbw_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="cbw_lbt_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="cbt_support_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>
    
</robot>